{
  "name": "power-shift",
  "version": "0.0.1",
  "description": "Automatic per-game battery and plugged performance profiles for Steam Deck",
  "author": "vpraion",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "deploy": "pnpm build && rsync -avz --exclude 'node_modules' --exclude '.git' ./ deck@steam-deck.vini.home.arpa:/home/deck/homebrew/plugins/PowerShift/",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@decky/rollup": "^1.0.2",
    "@rollup/plugin-commonjs": "^26.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "husky": "^9.1.7",
    "rollup": "^4.65.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.16.4",
    "react-icons": "^5.7.0"
  }
}
